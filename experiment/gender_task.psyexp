        <Param val="True" valType="bool" updates="None" name="syncScreenRefresh"/>
        <Param val="You are about to see a series of human faces on the screen. Your task is to decide the gender of the person, IGNORING the facial expression (angry, happy, or neutral).&amp;#10;&amp;#10;If the person you see is FEMALE, press the F key. If the person you see is MALE, press the M key.&amp;#10;&amp;#10;Please try to respond as quickly and accurately as possible. Press the spacebar to begin when you are ready." valType="str" updates="constant" name="text"/>
